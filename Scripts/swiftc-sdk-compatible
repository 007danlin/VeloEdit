#!/bin/zsh
# Local Command Line Tools workaround: the installed Swift frontend is two patch
# revisions newer than its macOS 26 SDK interfaces. Remove once CLT is updated.
# Keep this cache versioned. SwiftPM does not track changes inside SWIFT_EXEC,
# so changing the compatibility recipe must not reuse a module produced by an
# older version of this wrapper.
module_root="${TMPDIR:-/tmp}/veloedit-swift-sdk-compat-v2"
module_dir="$module_root/Swift.swiftmodule"
source_dir="/Library/Developer/CommandLineTools/SDKs/MacOSX26.0.sdk/usr/lib/swift/Swift.swiftmodule"
interface="$module_dir/arm64-apple-macos.swiftinterface"

if [[ ! -f "$interface" ]]; then
  mkdir -p "$module_dir"
  cp "$source_dir/arm64e-apple-macos.swiftinterface" "$interface"
  cp "$source_dir/arm64e-apple-macos.swiftdoc" "$module_dir/arm64-apple-macos.swiftdoc"
  perl -pi -e '
    s/swiftlang-6\.2\.0\.17\.14 clang-1700\.3\.17\.1/swiftlang-6.2.0.19.9 clang-1700.3.19.1/g;
    s/arm64e-apple-/arm64-apple-/g;
  ' "$interface"
fi

frameworks="/Library/Developer/CommandLineTools/Library/Developer/Frameworks"
plugins="/Library/Developer/CommandLineTools/usr/lib/swift/host/plugins/testing"

exec /Library/Developer/CommandLineTools/usr/bin/swiftc "$@" \
  -I "$module_root" \
  -F "$frameworks" \
  -Xfrontend -disable-cross-import-overlays \
  -Xfrontend -plugin-path -Xfrontend "$plugins" \
  -Xlinker -rpath -Xlinker "$frameworks"
