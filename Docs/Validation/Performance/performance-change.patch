+private let validVisionResponse = #"{"scenes":[{"index":3,"interest":0.7,"action":0.6,"quality":0.8,"stability":0.9,"storyValue":0.7,"scene":"A cyclist","tags":["bicycle"],"reason":"Clear action"}]}"#
