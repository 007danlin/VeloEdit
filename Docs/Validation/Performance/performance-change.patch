+            subjects: $0.subjects, width: $0.pixelWidth, height: $0.pixelHeight) }
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        guard var data = try? encoder.encode(values) else { return UUID().uuidString }
