+private actor DecodeConcurrencyProbe {
+    var active = 0
+    var peak = 0
+    func produce() async throws -> VisualFrameSample {
+        active += 1; peak = max(peak, active)
+        defer { active -= 1 }
+        try await Task.sleep(for: .milliseconds(20))
+        return performanceSample()
+    }
+}
